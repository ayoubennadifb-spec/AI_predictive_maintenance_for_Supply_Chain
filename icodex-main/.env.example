# Copy to `.env` (do not commit secrets) or export as environment variables.
CEREBRAS_API_KEY=csk-REPLACE_ME

# Option A (no DB): persist files + state on a Render Disk (mount example: /var/data)
# ICODEX_DATA_DIR=/var/data

# Option B (recommended for free persistence): use Postgres for app state (users/tests/classes).
# Example: postgresql://user:pass@host/db?sslmode=require
# DATABASE_URL=postgresql://REPLACE_ME

# If DATABASE_URL is set, the app will also persist quiz artifacts to Postgres:
# - quiz JSON (JSONB)
# - quiz PDF (BYTEA)
# Optionally store the original uploaded PDF too:
# ICODEX_STORE_SOURCE_PDF=true
